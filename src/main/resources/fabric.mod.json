{
	"schemaVersion": 1,
	"id": "compat_login",
	"version": "${version}",
	"name": "Compat Login",
	"description": "Allows Mojang and multiple Yggdrasil identity providers to authenticate on one Fabric server.",
	"authors": [
		"Compat Login contributors"
	],
	"license": "CC0-1.0",
	"icon": "assets/compat_login/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
			"cn.compatlogin.CompatLogin"
		]
	},
	"mixins": [
		"compat_login.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": ">=1.16 <=26.2",
		"java": ">=8"
	}
}
